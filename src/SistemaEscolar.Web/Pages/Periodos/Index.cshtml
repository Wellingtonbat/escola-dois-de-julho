@page
@using SistemaEscolar.Application.Periodos
@model SistemaEscolar.Web.Pages.Periodos.IndexModel
@{
    ViewData["Title"] = "Períodos";
    ViewData["Breadcrumb"] = new[] { "Acadêmico", "Períodos" };
    var podeGerenciar = User.IsInRole("Diretor") || User.IsInRole("Coordenador") || User.IsInRole("Cordenador") || User.IsInRole("Secretaria");
    var hoje = DateTime.UtcNow;
}

<section class="panel">
    <div class="panel-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h5 mb-1">Períodos de Lançamento</h1>
            <p class="text-muted mb-0">Controle de abertura e fechamento dos períodos para lançamento de notas.</p>
        </div>
        @if (podeGerenciar)
        {
            <button type="button" class="btn btn-primary btn-sm" data-bs-toggle="modal"
                    data-bs-target="#createPeriodoModal">
                Novo Período
            </button>
        }
    </div>

    <div class="panel-body">
        <form method="get" class="row g-2 mb-3">
            <div class="col-12 col-md-2">
                <input asp-for="AnoLetivo" type="number" class="form-control" placeholder="Ano" />
            </div>
            <div class="col-12 col-md-2">
                <select asp-for="Trimestre" class="form-select">
                    <option value="">Todos trimestres</option>
                    <option value="1">1o Trimestre</option>
                    <option value="2">2o Trimestre</option>
                    <option value="3">3o Trimestre</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <select asp-for="Status" class="form-select">
                    <option value="todos">Todos</option>
                    <option value="abertos">Abertos</option>
                    <option value="fechados">Fechados</option>
                </select>
            </div>
            <div class="col-12 col-md-8 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-page="/Periodos/Index" class="btn btn-outline-secondary">Limpar</a>
            </div>
        </form>

        <div class="panel-table-wrap">
            <table class="table-sneat">
                <thead>
                    <tr>
                        <th>Ano</th>
                        <th>Trimestre</th>
                        <th>Descrição</th>
                        <th>Início</th>
                        <th>Fim</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Periodos.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted">Nenhum período encontrado.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var periodo in Model.Periodos)
                        {
                            var estaAberto = PeriodoDisponibilidade.EstaAberto(periodo, hoje);
                            <tr class="@(podeGerenciar ? "row-clicavel" : null)" data-edit-trigger=".btn-edit-periodo">
                                <td>@periodo.AnoLetivo</td>
                                <td>@periodo.Trimestre</td>
                                <td>@periodo.Descricao</td>
                                <td>@periodo.DataInicial.ToString("dd/MM/yyyy")</td>
                                <td>@periodo.DataFinal.ToString("dd/MM/yyyy")</td>
                                <td>
                                    <span class="status-pill @(estaAberto ? "status-open" : "status-warn")">
                                        @(estaAberto ? "Aberto" : "Fechado")
                                    </span>
                                    @if (!estaAberto)
                                    {
                                        <div class="small text-muted mt-1">@PeriodoDisponibilidade.ObterMotivoFechado(periodo, hoje)</div>
                                    }
                                </td>
                                <td>
                                    @if (podeGerenciar)
                                    {
                                        <div class="actions-cell">
                                            <button type="button" class="icon-btn edit btn-edit-periodo"
                                                    data-bs-toggle="modal" data-bs-target="#editPeriodoModal" data-id="@periodo.Id"
                                                    data-ano="@periodo.AnoLetivo" data-trimestre="@periodo.Trimestre"
                                                    data-descricao="@periodo.Descricao"
                                                    data-inicio="@periodo.DataInicial.ToString("yyyy-MM-dd")"
                                                    data-fim="@periodo.DataFinal.ToString("yyyy-MM-dd")"
                                                    title="Editar">
                                                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10Z" /></svg>
                                            </button>
                                            @if (User.IsInRole("Diretor"))
                                            {
                                                <form method="post" asp-page-handler="@(periodo.IsAberto ? "Fechar" : "Abrir")"
                                                      asp-route-id="@periodo.Id" class="m-0">
                                                    <button type="submit" class="icon-btn toggle" title="@(periodo.IsAberto ? "Fechar antecipadamente" : "Reabrir")"
                                                            onclick="return confirm('Tem certeza que deseja @(periodo.IsAberto ? "fechar antecipadamente" : "reabrir") este período?');">
                                                        <svg viewBox="0 0 16 16" fill="currentColor"><path d="M2.5 8a5.5 5.5 0 0 1 8.25-4.764.5.5 0 0 0 .5-.866A6.5 6.5 0 1 0 14.5 8a.5.5 0 0 0-1 0 5.5 5.5 0 1 1-11 0z" /><path d="M15.354 3.354a.5.5 0 0 0-.708-.708L8 9.293 5.854 7.146a.5.5 0 1 0-.708.708l2.5 2.5a.5.5 0 0 0 .708 0z" /></svg>
                                                    </button>
                                                </form>
                                                <form method="post" asp-page-handler="Delete" asp-route-id="@periodo.Id" class="m-0">
                                                    <button type="submit" class="icon-btn delete" title="Excluir"
                                                            onclick="return confirm('Tem certeza que deseja excluir este período?');">
                                                        <svg viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" /></svg>
                                                    </button>
                                                </form>
                                            }
                                            <span class="row-chevron">
                                                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" /></svg>
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Somente consulta</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</section>

@if (User.IsInRole("Diretor") || User.IsInRole("Coordenador") || User.IsInRole("Cordenador") || User.IsInRole("Secretaria"))
{
    <div class="modal fade" id="createPeriodoModal" tabindex="-1" aria-labelledby="createPeriodoModalLabel"
         aria-hidden="true">
        <div class="modal-dialog modal-tall">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="modal-header-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4V.5ZM1 4h14v10a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4Z" />
                            </svg>
                        </span>
                        <h5 class="modal-title" id="createPeriodoModalLabel">Novo Período</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <form method="post" asp-page-handler="Create">
                    <div class="modal-body">
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="create-periodo-ano" class="form-label">Ano Letivo</label>
                                <input type="number" id="create-periodo-ano" name="anoLetivo" class="form-control"
                                       min="2000" max="2100" value="2026" required />
                            </div>
                            <div class="col-6">
                                <label for="create-periodo-trimestre" class="form-label">Trimestre</label>
                                <select id="create-periodo-trimestre" name="trimestre" class="form-select" required>
                                    <option value="1">1o</option>
                                    <option value="2">2o</option>
                                    <option value="3">3o</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3 mt-2">
                            <label for="create-periodo-descricao" class="form-label">Descrição</label>
                            <input type="text" id="create-periodo-descricao" name="descricao" class="form-control"
                                   required />
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="create-periodo-inicio" class="form-label">Data Inicial</label>
                                <input type="date" id="create-periodo-inicio" name="dataInicial" class="form-control"
                                       required />
                            </div>
                            <div class="col-6">
                                <label for="create-periodo-fim" class="form-label">Data Final</label>
                                <input type="date" id="create-periodo-fim" name="dataFinal" class="form-control" required />
                            </div>
                        </div>
                        <p class="small text-muted mt-2 mb-0">
                            O período fica disponível para lançamento de notas automaticamente entre a Data Inicial e a Data Final.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Confirmar cadastro deste período?');">Salvar período</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="modal fade" id="editPeriodoModal" tabindex="-1" aria-labelledby="editPeriodoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-tall">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="modal-header-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4V.5ZM1 4h14v10a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4Z" />
                            </svg>
                        </span>
                        <h5 class="modal-title" id="editPeriodoModalLabel">Editar Período</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <form method="post" asp-page-handler="Edit">
                    <div class="modal-body">
                        <input type="hidden" id="edit-periodo-id" name="id" />
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="edit-periodo-ano" class="form-label">Ano Letivo</label>
                                <input type="number" id="edit-periodo-ano" name="anoLetivo" class="form-control" min="2000"
                                       max="2100" required />
                            </div>
                            <div class="col-6">
                                <label for="edit-periodo-trimestre" class="form-label">Trimestre</label>
                                <select id="edit-periodo-trimestre" name="trimestre" class="form-select" required>
                                    <option value="1">1o</option>
                                    <option value="2">2o</option>
                                    <option value="3">3o</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3 mt-2">
                            <label for="edit-periodo-descricao" class="form-label">Descrição</label>
                            <input type="text" id="edit-periodo-descricao" name="descricao" class="form-control" required />
                        </div>
                        <div class="row g-2">
                            <div class="col-6">
                                <label for="edit-periodo-inicio" class="form-label">Data Inicial</label>
                                <input type="date" id="edit-periodo-inicio" name="dataInicial" class="form-control"
                                       required />
                            </div>
                            <div class="col-6">
                                <label for="edit-periodo-fim" class="form-label">Data Final</label>
                                <input type="date" id="edit-periodo-fim" name="dataFinal" class="form-control" required />
                            </div>
                        </div>
                        <p class="small text-muted mt-2 mb-0">
                            O período fica disponível para lançamento de notas automaticamente entre a Data Inicial e a Data Final.
                            Use o botão de fechar/reabrir na lista para uma exceção manual.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Confirmar atualização deste período?');">Salvar alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            (() => {
                const editModal = document.getElementById("editPeriodoModal");
                if (!editModal) {
                    return;
                }

                const idInput = document.getElementById("edit-periodo-id");
                const anoInput = document.getElementById("edit-periodo-ano");
                const trimestreInput = document.getElementById("edit-periodo-trimestre");
                const descricaoInput = document.getElementById("edit-periodo-descricao");
                const inicioInput = document.getElementById("edit-periodo-inicio");
                const fimInput = document.getElementById("edit-periodo-fim");

                document.querySelectorAll(".btn-edit-periodo").forEach((button) => {
                    button.addEventListener("click", () => {
                        idInput.value = button.dataset.id || "";
                        anoInput.value = button.dataset.ano || "";
                        trimestreInput.value = button.dataset.trimestre || "";
                        descricaoInput.value = button.dataset.descricao || "";
                        inicioInput.value = button.dataset.inicio || "";
                        fimInput.value = button.dataset.fim || "";
                    });
                });
            })();
        </script>
    }
}
