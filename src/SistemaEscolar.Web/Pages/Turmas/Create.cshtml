@page
@model SistemaEscolar.Web.Pages.Turmas.CreateModel
@{
    ViewData["Title"] = "Nova Turma";
    ViewData["Breadcrumb"] = new[] { "Acadêmico", "Turmas", "Novo" };
}

<section class="panel">
    <div class="panel-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h5 mb-1">Cadastro de Turma</h1>
            <p class="text-muted mb-0">Preencha os dados obrigatórios para criar uma nova turma.</p>
        </div>
        <a asp-page="/Turmas/Index" class="btn btn-outline-secondary btn-sm">Voltar</a>
    </div>
    <div class="panel-body">
        <form method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>

            <div class="col-12 col-md-6">
                <label asp-for="Input.Nome" class="form-label"></label>
                <input asp-for="Input.Nome" class="form-control" />
                <span asp-validation-for="Input.Nome" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-6">
                <label asp-for="Input.SerieId" class="form-label"></label>
                <select asp-for="Input.SerieId" class="form-select">
                    <option value="">Selecione...</option>
                    @foreach (var serie in Model.Series)
                    {
                        <option value="@serie.Value">@serie.Text</option>
                    }
                </select>
                <span asp-validation-for="Input.SerieId" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-4">
                <label asp-for="Input.Turno" class="form-label"></label>
                <input asp-for="Input.Turno" class="form-control" placeholder="Ex.: Manhã" />
                <span asp-validation-for="Input.Turno" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-4">
                <label asp-for="Input.AnoLetivo" class="form-label"></label>
                <input asp-for="Input.AnoLetivo" type="number" class="form-control" min="2000" max="2100" />
                <span asp-validation-for="Input.AnoLetivo" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-4 d-flex align-items-center">
                <div class="form-check mt-4">
                    <input asp-for="Input.IsAtiva" class="form-check-input" />
                    <label asp-for="Input.IsAtiva" class="form-check-label"></label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary" onclick="return confirm('Confirma o cadastro desta turma?');">Salvar Turma</button>
                <a asp-page="/Turmas/Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
