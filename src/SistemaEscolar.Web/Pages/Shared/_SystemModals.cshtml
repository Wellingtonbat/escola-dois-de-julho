<div class="modal fade" id="systemConfirmModal" tabindex="-1" aria-labelledby="systemConfirmModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content confirm-modal-content border-0">
            <div class="modal-header">
                <h5 class="modal-title d-flex align-items-center gap-2" id="systemConfirmModalLabel">
                    <span class="confirm-modal-icon" aria-hidden="true">!</span>
                    <span>Confirmação obrigatória</span>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0 fw-semibold" id="systemConfirmModalMessage">Tem certeza que deseja continuar?</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="systemConfirmModalAccept">Confirmar ação</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="systemFeedbackModal" tabindex="-1" aria-labelledby="systemFeedbackModalLabel"
     aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="systemFeedbackModalLabel">Resultado da ação</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0" id="systemFeedbackModalMessage"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Ok</button>
            </div>
        </div>
    </div>
</div>
