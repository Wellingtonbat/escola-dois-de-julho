@using SistemaEscolar.Infrastructure.Identity
@using Microsoft.AspNetCore.Identity
@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@{
    var currentPath = ViewContext.HttpContext.Request.Path.Value ?? string.Empty;
    var title = ViewData["Title"]?.ToString() ?? "Sistema Escolar";
    var breadcrumb = ViewData["Breadcrumb"] as string[];
    breadcrumb ??= new[] { "Dashboard", title };
    var entryAssembly = System.Reflection.Assembly.GetEntryAssembly();
    var infoAttr = entryAssembly is null
        ? null
        :
System.Reflection.CustomAttributeExtensions.GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(entryAssembly);
    var appVersion = infoAttr?.InformationalVersion;

    if (string.IsNullOrWhiteSpace(appVersion))
    {
        appVersion = entryAssembly?.GetName().Version?.ToString(3) ?? "1.0.0";
    }

    var dashboardActive = currentPath.Equals("/", StringComparison.OrdinalIgnoreCase)
        || currentPath.Equals("/Index", StringComparison.OrdinalIgnoreCase);
    var alunosActive = currentPath.StartsWith("/Alunos", StringComparison.OrdinalIgnoreCase);
    var disciplinasActive = currentPath.StartsWith("/Disciplinas", StringComparison.OrdinalIgnoreCase);
    var periodosActive = currentPath.StartsWith("/Periodos", StringComparison.OrdinalIgnoreCase);
    var professoresActive = currentPath.StartsWith("/Professores", StringComparison.OrdinalIgnoreCase);
    var turmasActive = currentPath.StartsWith("/Turmas", StringComparison.OrdinalIgnoreCase);
    var seriesActive = currentPath.StartsWith("/Series", StringComparison.OrdinalIgnoreCase);
    var notasActive = currentPath.StartsWith("/Notas", StringComparison.OrdinalIgnoreCase);
    var resultadosActive = currentPath.StartsWith("/Resultados", StringComparison.OrdinalIgnoreCase);
    var usuariosActive = currentPath.StartsWith("/Usuarios", StringComparison.OrdinalIgnoreCase);
    var podeGerenciarUsuarios = User.IsInRole("Diretor") || User.IsInRole("Coordenador") || User.IsInRole("Cordenador") || User.IsInRole("Secretaria");
    var isProfessorOnly = User.IsInRole("Professor") && !podeGerenciarUsuarios;
    var successMessage = TempData["SuccessMessage"]?.ToString();
    var errorMessage = TempData["ErrorMessage"]?.ToString();

    string? usuarioLogadoNome = null;
    if (SignInManager.IsSignedIn(User))
    {
        var usuarioLogado = await UserManager.GetUserAsync(User);
        usuarioLogadoNome = string.IsNullOrWhiteSpace(usuarioLogado?.FullName) ? User.Identity?.Name : usuarioLogado.FullName;
    }
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Escolar</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700&display=swap"
          rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SistemaEscolar.Web.styles.css" asp-append-version="true" />
</head>

<body class="app-body" data-flash-success="@successMessage" data-flash-error="@errorMessage">
    <div class="app-shell" id="appShell">
        <aside class="app-sidebar" id="appSidebar">
            <div class="sidebar-brand">
                <span class="brand-badge">SE</span>
                <div>
                    <p class="brand-title mb-0">Sistema Escolar</p>
                    <small class="brand-subtitle">Painel Administrativo</small>
                </div>
            </div>

            <nav class="sidebar-nav">
                <small class="sidebar-section-title">Acadêmico</small>
                <a asp-page="/Index" class="sidebar-link @(dashboardActive ? "active" : null)">
                    <span class="sidebar-link-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M1 1h6v6H1V1Zm8 0h6v6H9V1ZM1 9h6v6H1V9Zm8 0h6v6H9V9Z" /></svg>
                    </span>
                    <span class="sidebar-link-label">Dashboard</span>
                </a>
                @if (!isProfessorOnly)
                {
                    <a asp-page="/Alunos/Index" class="sidebar-link @(alunosActive ? "active" : null)">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M8 1 15 4.5 8 8 1 4.5 8 1Z" /><path d="M4 6.2v3.3c0 .9 1.8 1.8 4 1.8s4-.9 4-1.8V6.2L8 8 4 6.2Z" /><path d="M14 6v3.5a.5.5 0 0 0 1 0V6h-1Z" /></svg>
                        </span>
                        <span class="sidebar-link-label">Alunos</span>
                    </a>
                    <a asp-page="/Disciplinas/Index" class="sidebar-link @(disciplinasActive ? "active" : null)">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M2 2.75A1.75 1.75 0 0 1 3.75 1H8v14H3.75A1.75 1.75 0 0 1 2 13.25V2.75Z" /><path d="M8 1h4.25A1.75 1.75 0 0 1 14 2.75v10.5A1.75 1.75 0 0 1 12.25 15H8V1Z" opacity=".55" /></svg>
                        </span>
                        <span class="sidebar-link-label">Disciplinas</span>
                    </a>
                    <a asp-page="/Periodos/Index" class="sidebar-link @(periodosActive ? "active" : null)">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M4 .5a.5.5 0 0 0-1 0V1H2a2 2 0 0 0-2 2v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V3a2 2 0 0 0-2-2h-1V.5a.5.5 0 0 0-1 0V1H4V.5ZM1 4h14v10a1 1 0 0 1-1 1H2a1 1 0 0 1-1-1V4Z" /></svg>
                        </span>
                        <span class="sidebar-link-label">Períodos</span>
                    </a>
                    <a asp-page="/Professores/Index" class="sidebar-link @(professoresActive ? "active" : null)">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6Zm2 1H6a4 4 0 0 0-4 4v1a1 1 0 0 0 1 1h10a1 1 0 0 0 1-1v-1a4 4 0 0 0-4-4Z" /></svg>
                        </span>
                        <span class="sidebar-link-label">Professores</span>
                    </a>
                    <a asp-page="/Turmas/Index" class="sidebar-link @(turmasActive ? "active" : null)">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M6 8a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm4.5-1a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM6 9c-2.5 0-5 1.2-5 3v1a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1v-1c0-1.8-2.5-3-5-3Zm7 0c-.4 0-.9.05-1.3.15C12.5 9.8 13 10.8 13 12v1h2a1 1 0 0 0 1-1v-1c0-1.5-2-3-4-3Z" /></svg>
                        </span>
                        <span class="sidebar-link-label">Turmas</span>
                    </a>
                    <a asp-page="/Series/Index" class="sidebar-link @(seriesActive ? "active" : null)">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M1 13h2v2H1v-2Zm4-4h2v6H5V9Zm4-3h2v9H9V6Zm4-4h2v13h-2V2Z" /></svg>
                        </span>
                        <span class="sidebar-link-label">Séries</span>
                    </a>
                }
                <a asp-page="/Notas/Index" class="sidebar-link @(notasActive ? "active" : null)">
                    <span class="sidebar-link-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10Z" /></svg>
                    </span>
                    <span class="sidebar-link-label">Notas</span>
                </a>
                <a asp-page="/Resultados/Index" class="sidebar-link @(resultadosActive ? "active" : null)">
                    <span class="sidebar-link-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M0 14.5a.5.5 0 0 0 .5.5h15a.5.5 0 0 0 0-1H1V.5a.5.5 0 0 0-1 0v14Z" /><path d="M14.5 3.5a.5.5 0 0 0-.5-.5h-3a.5.5 0 1 0 0 1h1.79l-3.3 3.3-2-2a.5.5 0 0 0-.7 0l-4 4a.5.5 0 1 0 .7.7L7 6.41l2 2a.5.5 0 0 0 .7 0l3.5-3.5V6.5a.5.5 0 0 0 1 0v-3Z" /></svg>
                    </span>
                    <span class="sidebar-link-label">Resultados</span>
                </a>
                @if (podeGerenciarUsuarios)
                {
                    <a asp-page="/Usuarios/Index" class="sidebar-link @(usuariosActive ? "active" : null)">
                        <span class="sidebar-link-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 7a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5Zm5-1.5a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM0 13c0-1.9 2.5-3.5 5.5-3.5S11 11.1 11 13v1H0v-1Zm12.5-2c-.3 0-.6.02-.9.06.9.7 1.4 1.7 1.4 2.94v1H16v-1c0-1.6-1.6-3-3.5-3Z" /></svg>
                        </span>
                        <span class="sidebar-link-label">Usuários</span>
                    </a>
                }
                <a asp-page="/Manual/Index" asp-page-handler="DownloadPdf" class="sidebar-link">
                    <span class="sidebar-link-icon" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor"><path d="M4 0a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V4.5L9.5 0H4Z" /><path d="M9.5 0v4a.5.5 0 0 0 .5.5h4L9.5 0Z" opacity=".5" /></svg>
                    </span>
                    <span class="sidebar-link-label">Baixar Manual (PDF)</span>
                </a>

            </nav>
        </aside>

                                                <div class="app-main">
                                                    <header class="app-topbar">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <button type="button" class="btn btn-sm btn-outline-secondary" id="sidebarToggle"
                                                                    aria-label="Alternar menu lateral" aria-expanded="true">
                                                                <span class="sidebar-toggle-icon" aria-hidden="true">&#8249;</span>
                                                                <span class="sidebar-toggle-text d-lg-none ms-1">Menu</span>
                                                            </button>
                                                            <div>
                                                                <p class="topbar-title mb-0">@ViewData["Title"]</p>
                                                                <small class="topbar-subtitle">Gestão acadêmica e operacional</small>
                                                                <nav aria-label="breadcrumb" class="mt-1">
                                                                    <ol class="topbar-breadcrumb mb-0">
                                                                        @for (var i = 0; i < breadcrumb.Length; i++)
                                                                        {
                                                                            var item = breadcrumb[i];
                                                                            if (i == breadcrumb.Length - 1)
                                                                            {
                                                                                <li class="current" aria-current="page">@item</li>
                                                                            }
                                                                            else
                                                                            {
                                                                                <li>@item</li>
                                                                            }
                                                                        }
                                                                    </ol>
                                                                </nav>
                                                            </div>
                                                        </div>

                                                        <div class="topbar-actions">
                                                            @if (SignInManager.IsSignedIn(User))
                                                            {
                                                                <span class="user-chip">@usuarioLogadoNome</span>
                                                                <form method="post" asp-page="/Logout" class="mb-0">
                                                                    <button type="submit" class="btn btn-sm btn-outline-primary"
                                                                            onclick="return confirm('Tem certeza que deseja sair do sistema?');">Sair</button>
                                                                </form>
                                                            }
                                                            else
                                                            {
                                                                <a class="btn btn-sm btn-primary" asp-page="/Login">Entrar</a>
                                                            }
                                                        </div>
                                                    </header>

                                                    <main role="main" class="page-wrap">
                                                        @RenderBody()
                                                    </main>

                                                    <footer class="app-footer">
                                                        <span>&copy; @(DateTime.Now.Year) Sistema Escolar &mdash; Desenvolvido por Well Tech &mdash; v@(appVersion)</span>
                                                    </footer>
                                                </div>
                                            </div>
                                            <div class="app-overlay d-lg-none" id="appOverlay"></div>

                                            <partial name="_SystemModals" />

                                            <script src="~/lib/jquery/dist/jquery.min.js"></script>
                                            <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
                                            <script src="~/js/site.js" asp-append-version="true"></script>

                                            @await RenderSectionAsync("Scripts", required: false)
                                        </body>

                                    </html>
