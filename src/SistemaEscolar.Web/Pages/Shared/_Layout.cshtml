@{
    var entryAssembly = System.Reflection.Assembly.GetEntryAssembly();
    var infoAttr = entryAssembly is null
        ? null
        :
System.Reflection.CustomAttributeExtensions.GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(entryAssembly);
    var appVersion = infoAttr?.InformationalVersion;

    if (string.IsNullOrWhiteSpace(appVersion))
    {
        appVersion = entryAssembly?.GetName().Version?.ToString(3) ?? "1.0.0";
    }

    var successMessage = TempData["SuccessMessage"]?.ToString();
    var errorMessage = TempData["ErrorMessage"]?.ToString();
}

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema Escolar</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/fonts.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<body class="app-body" data-flash-success="@successMessage" data-flash-error="@errorMessage">
    <div class="app-shell" id="appShell">
        <partial name="_Sidebar" />

        <div class="app-main">
            <partial name="_Topbar" />

            <main role="main" class="page-wrap">
                @RenderBody()
            </main>

            <footer class="app-footer">
                <span>&copy; @(DateTime.Now.Year) Sistema Escolar &mdash; Desenvolvido por Well Tech &mdash; v@(appVersion)</span>
            </footer>
        </div>
    </div>
    <div class="app-overlay d-lg-none" id="appOverlay"></div>

    <partial name="_SystemModals" />

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>
