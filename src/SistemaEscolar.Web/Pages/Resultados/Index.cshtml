@page
@model SistemaEscolar.Web.Pages.Resultados.IndexModel
@{
    ViewData["Title"] = "Resultados";
    ViewData["Breadcrumb"] = new[] { "Acadêmico", "Resultados" };

    var situacaoLabel = Model.Situacao switch { "Aprovado" => "Aprovados", "Reprovado" => "Reprovados", "Pendente" => "Pendentes", _ => null };
    var filtrosAtivos = new List<(string Label, string Campo)>();
    if (!string.IsNullOrWhiteSpace(Model.Busca)) { filtrosAtivos.Add(($"Busca: {Model.Busca}", "Busca")); }
    if (!string.IsNullOrWhiteSpace(Model.Turma)) { filtrosAtivos.Add(($"Turma: {Model.Turma}", "Turma")); }
    if (!string.IsNullOrWhiteSpace(Model.Serie)) { filtrosAtivos.Add(($"Série: {Model.Serie}", "Serie")); }
    if (situacaoLabel is not null) { filtrosAtivos.Add((situacaoLabel, "Situacao")); }
}

<section class="panel">
    <div class="panel-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h5 mb-1">Aprovação e Reprovação</h1>
            <p class="text-muted mb-0">Consolidação do resultado final por aluno no ano letivo selecionado.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Resultados/Index" asp-page-handler="ExportCsv" asp-route-Busca="@Model.Busca"
               asp-route-AnoLetivo="@Model.AnoLetivo" asp-route-Turma="@Model.Turma" asp-route-Serie="@Model.Serie"
               asp-route-Situacao="@Model.Situacao" asp-route-Ordenacao="@Model.Ordenacao"
               asp-route-Direcao="@Model.Direcao" class="btn btn-outline-primary btn-sm">
                Exportar CSV
            </a>
            <a asp-page="/Resultados/Index" asp-page-handler="ExportExcel" asp-route-Busca="@Model.Busca"
               asp-route-AnoLetivo="@Model.AnoLetivo" asp-route-Turma="@Model.Turma" asp-route-Serie="@Model.Serie"
               asp-route-Situacao="@Model.Situacao" asp-route-Ordenacao="@Model.Ordenacao"
               asp-route-Direcao="@Model.Direcao" class="btn btn-outline-success btn-sm">
                Exportar Excel
            </a>
            <a asp-page="/Resultados/Index" asp-page-handler="ExportPdf" asp-route-Busca="@Model.Busca"
               asp-route-AnoLetivo="@Model.AnoLetivo" asp-route-Turma="@Model.Turma" asp-route-Serie="@Model.Serie"
               asp-route-Situacao="@Model.Situacao" asp-route-Ordenacao="@Model.Ordenacao"
               asp-route-Direcao="@Model.Direcao" class="btn btn-outline-danger btn-sm">
                Exportar PDF
            </a>
        </div>
    </div>

    <div class="panel-body">
        <div class="filter-panel">
            <div class="filter-panel-header">
                <span class="filter-icon-badge" aria-hidden="true">
                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M1.5 2.5A.5.5 0 0 1 2 2h12a.5.5 0 0 1 .4.8L10 8.9V13.5a.5.5 0 0 1-.74.44l-2-1.1a.5.5 0 0 1-.26-.44V8.9L1.6 2.8a.5.5 0 0 1-.1-.3Z" /></svg>
                </span>
                <span class="filter-panel-title">Filtros</span>
                @if (filtrosAtivos.Count > 0)
                {
                    <span class="filter-active-count">@filtrosAtivos.Count ativo@(filtrosAtivos.Count > 1 ? "s" : "")</span>
                }
            </div>
            <form method="get" class="filter-bar">
                <input type="hidden" name="PageNumber" value="1" />
                <div class="filter-field filter-field-wide">
                    <label for="resultados-busca">Buscar</label>
                    <div class="filter-input-icon">
                        <svg viewBox="0 0 16 16" fill="currentColor"><path d="M11.74 10.33a6.5 6.5 0 1 0-1.41 1.41l3.47 3.47a1 1 0 0 0 1.41-1.41ZM12 6.5A5.5 5.5 0 1 1 6.5 1a5.5 5.5 0 0 1 5.5 5.5" /></svg>
                        <input asp-for="Busca" id="resultados-busca" class="form-control" placeholder="Aluno, disciplina ou professor" />
                    </div>
                </div>
                <div class="filter-field">
                    <label for="resultados-ano">Ano letivo</label>
                    <input asp-for="AnoLetivo" id="resultados-ano" type="number" class="form-control" placeholder="Ano" />
                </div>
                <div class="filter-field">
                    <label for="resultados-turma">Turma</label>
                    <select asp-for="Turma" id="resultados-turma" class="form-select">
                        <option value="">Todas as turmas</option>
                        @foreach (var turma in Model.Turmas)
                        {
                            <option value="@turma.Value">@turma.Text</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label for="resultados-serie">Série</label>
                    <select asp-for="Serie" id="resultados-serie" class="form-select">
                        <option value="">Todas as séries</option>
                        @foreach (var serie in Model.Series)
                        {
                            <option value="@serie.Value">@serie.Text</option>
                        }
                    </select>
                </div>
                <div class="filter-field">
                    <label>Situação</label>
                    <div class="filter-pill-group">
                        <input type="radio" name="Situacao" id="resultados-sit-todos" value="todos" class="filter-pill-input" checked="@(Model.Situacao == "todos")" />
                        <label for="resultados-sit-todos" class="filter-pill">Todos</label>
                        <input type="radio" name="Situacao" id="resultados-sit-aprovado" value="Aprovado" class="filter-pill-input" checked="@(Model.Situacao == "Aprovado")" />
                        <label for="resultados-sit-aprovado" class="filter-pill">Aprovados</label>
                        <input type="radio" name="Situacao" id="resultados-sit-reprovado" value="Reprovado" class="filter-pill-input" checked="@(Model.Situacao == "Reprovado")" />
                        <label for="resultados-sit-reprovado" class="filter-pill">Reprovados</label>
                        <input type="radio" name="Situacao" id="resultados-sit-pendente" value="Pendente" class="filter-pill-input" checked="@(Model.Situacao == "Pendente")" />
                        <label for="resultados-sit-pendente" class="filter-pill">Pendentes</label>
                    </div>
                </div>
                <div class="filter-field">
                    <label for="resultados-ordenacao">Ordenar por</label>
                    <select asp-for="Ordenacao" id="resultados-ordenacao" class="form-select">
                        <option value="aluno">Aluno</option>
                        <option value="disciplina">Disciplina</option>
                        <option value="turma">Turma</option>
                        <option value="media">Média</option>
                        <option value="situacao">Situação</option>
                    </select>
                </div>
                <div class="filter-field">
                    <label for="resultados-direcao">Direção</label>
                    <select asp-for="Direcao" id="resultados-direcao" class="form-select" title="Direção">
                        <option value="asc">Crescente</option>
                        <option value="desc">Decrescente</option>
                    </select>
                </div>
                <div class="filter-actions">
                    <button type="submit" class="btn btn-primary">Filtrar</button>
                    <a asp-page="/Resultados/Index" class="btn btn-outline-secondary">Limpar</a>
                </div>
            </form>

            @if (filtrosAtivos.Count > 0)
            {
                <div class="filter-chips">
                    @foreach (var (label, campo) in filtrosAtivos)
                    {
                        <span class="filter-chip">
                            @label
                            <a asp-page="/Resultados/Index"
                               asp-route-Busca="@(campo == "Busca" ? null : Model.Busca)"
                               asp-route-AnoLetivo="@Model.AnoLetivo"
                               asp-route-Turma="@(campo == "Turma" ? null : Model.Turma)"
                               asp-route-Serie="@(campo == "Serie" ? null : Model.Serie)"
                               asp-route-Situacao="@(campo == "Situacao" ? "todos" : Model.Situacao)"
                               asp-route-Ordenacao="@Model.Ordenacao" asp-route-Direcao="@Model.Direcao"
                               title="Remover filtro">&times;</a>
                        </span>
                    }
                </div>
            }
        </div>

        <div class="kpi-grid mb-3" style="grid-template-columns:repeat(3, minmax(0, 1fr))">
            <article class="kpi-card kpi-card-icon">
                <div><span class="kpi-label">Aprovados</span><strong class="kpi-value">@Model.TotalAprovados</strong></div>
                <span class="kpi-icon kpi-icon-approved">
                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14Zm3.36-9.14-4 4a.5.5 0 0 1-.72 0l-2-2a.5.5 0 1 1 .72-.72L7 8.79l3.64-3.65a.5.5 0 0 1 .72.72Z" /></svg>
                </span>
            </article>
            <article class="kpi-card kpi-card-icon">
                <div><span class="kpi-label">Reprovados</span><strong class="kpi-value">@Model.TotalReprovados</strong></div>
                <span class="kpi-icon kpi-icon-danger">
                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14Zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16Z" /><path d="M5.354 4.646a.5.5 0 1 0-.708.708L7.293 8l-2.647 2.646a.5.5 0 0 0 .708.708L8 8.707l2.646 2.647a.5.5 0 0 0 .708-.708L8.707 8l2.647-2.646a.5.5 0 0 0-.708-.708L8 7.293 5.354 4.646Z" /></svg>
                </span>
            </article>
            <article class="kpi-card kpi-card-icon">
                <div><span class="kpi-label">Pendentes</span><strong class="kpi-value">@Model.TotalPendentes</strong></div>
                <span class="kpi-icon kpi-icon-pending">
                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8.982 1.566a1.13 1.13 0 0 0-1.964 0L.165 13.233c-.457.778.091 1.767.982 1.767h13.706c.891 0 1.439-.99.982-1.767zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z" /></svg>
                </span>
            </article>
        </div>

        <div class="panel-table-wrap">
            <table class="table-sneat">
                <thead>
                    <tr>
                        <th>Disciplina</th>
                        <th>Aluno</th>
                        <th>Turma</th>
                        <th>Série</th>
                        <th>Professor</th>
                        <th>Ano</th>
                        <th>Média Final</th>
                        <th>Recuperação Final</th>
                        <th>Resultado Final</th>
                        <th>Situação</th>
                        <th>Motivo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Resultados.Count == 0)
                    {
                        <tr>
                            <td colspan="11" class="text-center text-muted">Nenhum resultado encontrado.</td>
                        </tr>
                    }
                    else
                    {
                        var gruposDisciplina = Model.Resultados
                            .GroupBy(x => x.Disciplina)
                            .OrderBy(x => x.Key);

                        foreach (var grupo in gruposDisciplina)
                        {
                            <tr class="disciplina-group-row">
                                <td colspan="11">
                                    <span class="disciplina-group-title">@grupo.Key</span>
                                    <span class="meta-tag">@grupo.Count() aluno(s)</span>
                                </td>
                            </tr>

                            @foreach (var item in grupo)
                            {
                                <tr>
                                    <td>@item.Disciplina</td>
                                    <td>@item.AlunoNome</td>
                                    <td>@item.Turma</td>
                                    <td>@item.Serie</td>
                                    <td>@item.ProfessorNome</td>
                                    <td>@item.AnoLetivo</td>
                                    <td>@item.MediaFinal.ToString("0.00")</td>
                                    <td>
                                        @if (item.RecuperacaoFinalDisponivel && User.PodeAlterarNotas())
                                        {
                                            <form method="post" asp-page-handler="SalvarRecuperacaoFinal" class="d-flex gap-1 align-items-center">
                                                <input type="hidden" name="alunoId" value="@item.AlunoId" />
                                                <input type="hidden" name="disciplinaId" value="@item.DisciplinaId" />
                                                <input type="hidden" name="busca" value="@Model.Busca" />
                                                <input type="hidden" name="anoLetivo" value="@Model.AnoLetivo" />
                                                <input type="hidden" name="turma" value="@Model.Turma" />
                                                <input type="hidden" name="serie" value="@Model.Serie" />
                                                <input type="hidden" name="situacao" value="@Model.Situacao" />
                                                <input type="hidden" name="ordenacao" value="@Model.Ordenacao" />
                                                <input type="hidden" name="direcao" value="@Model.Direcao" />
                                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                <input type="text" inputmode="decimal" name="recuperacaoFinal" class="form-control form-control-sm"
                                                       style="width:70px" placeholder="0 a 10"
                                                       value="@(item.RecuperacaoFinal?.ToString("0.##"))" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Salvar Recuperação Final"
                                                        onclick="return confirm('Confirma o lançamento da Recuperação Final para este aluno nesta disciplina?');">
                                                    Salvar
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            @(item.RecuperacaoFinal.HasValue ? item.RecuperacaoFinal.Value.ToString("0.00") : "—")
                                        }
                                    </td>
                                    <td>@item.ResultadoFinalAno.ToString("0.00")</td>
                                    <td>
                                        <span
                                            class="status-pill @(item.Situacao == "Aprovado" ? "status-open" : item.Situacao == "Reprovado" ? "status-danger" : "status-warn")">
                                            @item.Situacao
                                        </span>
                                    </td>
                                    <td>@item.Motivo</td>
                                </tr>
                            }
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-3">
            <small class="text-muted">
                Exibindo @Model.Resultados.Count de @Model.TotalCount resultado(s) na página @Model.PageNumber de
                @Model.TotalPages.
            </small>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Paginação de resultados">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : string.Empty)">
                            <a class="page-link" asp-page="/Resultados/Index" asp-route-Busca="@Model.Busca"
                               asp-route-AnoLetivo="@Model.AnoLetivo" asp-route-Turma="@Model.Turma"
                               asp-route-Serie="@Model.Serie" asp-route-Situacao="@Model.Situacao"
                               asp-route-Ordenacao="@Model.Ordenacao" asp-route-Direcao="@Model.Direcao"
                               asp-route-PageSize="@Model.PageSize" asp-route-PageNumber="@(Model.PageNumber - 1)">
                                Anterior
                            </a>
                        </li>

                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : string.Empty)">
                                <a class="page-link" asp-page="/Resultados/Index" asp-route-Busca="@Model.Busca"
                                   asp-route-AnoLetivo="@Model.AnoLetivo" asp-route-Turma="@Model.Turma"
                                   asp-route-Serie="@Model.Serie" asp-route-Situacao="@Model.Situacao"
                                   asp-route-Ordenacao="@Model.Ordenacao" asp-route-Direcao="@Model.Direcao"
                                   asp-route-PageSize="@Model.PageSize" asp-route-PageNumber="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : string.Empty)">
                            <a class="page-link" asp-page="/Resultados/Index" asp-route-Busca="@Model.Busca"
                               asp-route-AnoLetivo="@Model.AnoLetivo" asp-route-Turma="@Model.Turma"
                               asp-route-Serie="@Model.Serie" asp-route-Situacao="@Model.Situacao"
                               asp-route-Ordenacao="@Model.Ordenacao" asp-route-Direcao="@Model.Direcao"
                               asp-route-PageSize="@Model.PageSize" asp-route-PageNumber="@(Model.PageNumber + 1)">
                                Próxima
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</section>
