@page
@model SistemaEscolar.Web.Pages.Series.IndexModel
@{
    ViewData["Title"] = "Séries";
    ViewData["Breadcrumb"] = new[] { "Acadêmico", "Séries" };
    var podeGerenciar = User.IsInRole("Diretor") || User.IsInRole("Coordenador") || User.IsInRole("Cordenador") || User.IsInRole("Secretaria");
}

<section class="panel">
    <div class="panel-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h5 mb-1">Gestão de Séries</h1>
            <p class="text-muted mb-0">Cadastro de séries para vínculo de alunos, disciplinas e professores.</p>
        </div>
        @if (podeGerenciar)
        {
            <a asp-page="/Series/Create" class="btn btn-primary btn-sm">Nova Série</a>
        }
    </div>

    <div class="panel-body">
        <form method="get" class="row g-2 mb-3">
            <input type="hidden" name="PageNumber" value="1" />
            <div class="col-12 col-md-8">
                <input asp-for="Busca" class="form-control" placeholder="Buscar por nome da série" />
            </div>
            <div class="col-12 col-md-2">
                <select asp-for="Status" class="form-select">
                    <option value="todos">Todos</option>
                    <option value="ativas">Apenas ativas</option>
                    <option value="inativas">Apenas inativas</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-page="/Series/Index" class="btn btn-outline-secondary">Limpar</a>
            </div>
        </form>

        <div class="panel-table-wrap">
            <table class="table-sneat">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Ordem</th>
                        <th>Status</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Series.Count == 0)
                    {
                        <tr>
                            <td colspan="4" class="text-center text-muted">Nenhuma série encontrada.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var serie in Model.Series)
                        {
                            <tr class="@(podeGerenciar ? "row-clicavel" : null)" data-edit-trigger=".btn-edit-serie">
                                <td>@serie.Nome</td>
                                <td>@serie.Ordem</td>
                                <td>
                                    <span class="status-pill @(serie.IsAtiva ? "status-open" : "status-warn")">
                                        @(serie.IsAtiva ? "Ativa" : "Inativa")
                                    </span>
                                </td>
                                <td>
                                    @if (podeGerenciar)
                                    {
                                        <div class="actions-cell">
                                            <button type="button" class="icon-btn edit btn-edit-serie"
                                                    data-bs-toggle="modal" data-bs-target="#editSerieModal" data-id="@serie.Id"
                                                    data-nome="@serie.Nome" data-ordem="@serie.Ordem" data-ativa="@serie.IsAtiva" title="Editar">
                                                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10Z" /></svg>
                                            </button>
                                            <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@serie.Id" class="m-0">
                                                <input type="hidden" name="busca" value="@Model.Busca" />
                                                <input type="hidden" name="status" value="@Model.Status" />
                                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                <button type="submit" class="icon-btn toggle" title="@(serie.IsAtiva ? "Desativar" : "Ativar")"
                                                        onclick="return confirm('Tem certeza que deseja @(serie.IsAtiva ? "desativar" : "ativar") esta série?');">
                                                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M2.5 8a5.5 5.5 0 0 1 8.25-4.764.5.5 0 0 0 .5-.866A6.5 6.5 0 1 0 14.5 8a.5.5 0 0 0-1 0 5.5 5.5 0 1 1-11 0z" /><path d="M15.354 3.354a.5.5 0 0 0-.708-.708L8 9.293 5.854 7.146a.5.5 0 1 0-.708.708l2.5 2.5a.5.5 0 0 0 .708 0z" /></svg>
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@serie.Id" class="m-0">
                                                <input type="hidden" name="busca" value="@Model.Busca" />
                                                <input type="hidden" name="status" value="@Model.Status" />
                                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                <button type="submit" class="icon-btn delete" title="Excluir"
                                                        onclick="return confirm('Tem certeza que deseja excluir esta série?');">
                                                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" /></svg>
                                                </button>
                                            </form>
                                            <span class="row-chevron">
                                                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" /></svg>
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Somente consulta</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-3">
            <small class="text-muted">
                Exibindo @Model.Series.Count de @Model.TotalCount série(s) na página @Model.PageNumber de
                @Model.TotalPages.
            </small>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Paginação de séries">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : string.Empty)">
                            <a class="page-link" asp-page="/Series/Index" asp-route-Busca="@Model.Busca"
                               asp-route-Status="@Model.Status" asp-route-PageSize="@Model.PageSize"
                               asp-route-PageNumber="@(Model.PageNumber - 1)">Anterior</a>
                        </li>

                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : string.Empty)">
                                <a class="page-link" asp-page="/Series/Index" asp-route-Busca="@Model.Busca"
                                   asp-route-Status="@Model.Status" asp-route-PageSize="@Model.PageSize"
                                   asp-route-PageNumber="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : string.Empty)">
                            <a class="page-link" asp-page="/Series/Index" asp-route-Busca="@Model.Busca"
                               asp-route-Status="@Model.Status" asp-route-PageSize="@Model.PageSize"
                               asp-route-PageNumber="@(Model.PageNumber + 1)">Próxima</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</section>

@if (User.IsInRole("Diretor") || User.IsInRole("Coordenador") || User.IsInRole("Cordenador") || User.IsInRole("Secretaria"))
{
    <div class="modal fade" id="editSerieModal" tabindex="-1" aria-labelledby="editSerieModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-tall">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="modal-header-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M1 13h2v2H1v-2Zm4-4h2v6H5V9Zm4-3h2v9H9V6Zm4-4h2v13h-2V2Z" />
                            </svg>
                        </span>
                        <h5 class="modal-title" id="editSerieModalLabel">Editar Série</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <form method="post" asp-page-handler="Edit">
                    <div class="modal-body">
                        <input type="hidden" id="edit-serie-id" name="id" />
                        <input type="hidden" name="busca" value="@Model.Busca" />
                        <input type="hidden" name="status" value="@Model.Status" />
                        <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                        <input type="hidden" name="pageSize" value="@Model.PageSize" />

                        <div class="mb-3">
                            <label for="edit-serie-nome" class="form-label">Nome</label>
                            <input type="text" id="edit-serie-nome" name="nome" class="form-control" required />
                        </div>
                        <div class="mb-3">
                            <label for="edit-serie-ordem" class="form-label">Ordem</label>
                            <input type="number" id="edit-serie-ordem" name="ordem" class="form-control" min="1" max="100"
                                   required />
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="edit-serie-ativa" name="isAtiva"
                                   value="true" />
                            <input type="hidden" name="isAtiva" value="false" />
                            <label class="form-check-label" for="edit-serie-ativa">Série ativa</label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary" onclick="return confirm('Confirmar atualização dos dados da série?');">Salvar alterações</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            (() => {
                const editModal = document.getElementById("editSerieModal");
                if (!editModal) {
                    return;
                }

                const idInput = document.getElementById("edit-serie-id");
                const nomeInput = document.getElementById("edit-serie-nome");
                const ordemInput = document.getElementById("edit-serie-ordem");
                const ativaInput = document.getElementById("edit-serie-ativa");

                document.querySelectorAll(".btn-edit-serie").forEach((button) => {
                    button.addEventListener("click", () => {
                        idInput.value = button.dataset.id || "";
                        nomeInput.value = button.dataset.nome || "";
                        ordemInput.value = button.dataset.ordem || "1";
                        ativaInput.checked = (button.dataset.ativa || "").toLowerCase() === "true";
                    });
                });
            })();
        </script>
    }
}
