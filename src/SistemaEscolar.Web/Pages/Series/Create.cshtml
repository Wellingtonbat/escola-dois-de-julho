@page
@model SistemaEscolar.Web.Pages.Series.CreateModel
@{
    ViewData["Title"] = "Nova Série";
    ViewData["Breadcrumb"] = new[] { "Acadêmico", "Séries", "Nova" };
}

<section class="panel">
    <div class="panel-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h5 mb-1">Cadastro de Série</h1>
            <p class="text-muted mb-0">Cadastre as séries para vincular alunos, disciplinas e professores.</p>
        </div>
        <a asp-page="/Series/Index" class="btn btn-outline-secondary btn-sm">Voltar</a>
    </div>
    <div class="panel-body">
        <form method="post" class="row g-3">
            <div asp-validation-summary="ModelOnly" class="text-danger col-12"></div>

            <div class="col-12 col-md-8">
                <label asp-for="Input.Nome" class="form-label"></label>
                <input asp-for="Input.Nome" class="form-control" placeholder="Ex.: 1o Ano" />
                <span asp-validation-for="Input.Nome" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-4">
                <label asp-for="Input.Ordem" class="form-label"></label>
                <input asp-for="Input.Ordem" type="number" min="1" max="100" class="form-control" />
                <span asp-validation-for="Input.Ordem" class="text-danger"></span>
            </div>

            <div class="col-12 col-md-4 d-flex align-items-center">
                <div class="form-check mt-4">
                    <input asp-for="Input.IsAtiva" class="form-check-input" />
                    <label asp-for="Input.IsAtiva" class="form-check-label"></label>
                </div>
            </div>

            <div class="col-12 d-flex gap-2">
                <button type="submit" class="btn btn-primary" onclick="return confirm('Confirma o cadastro desta série?');">Salvar Série</button>
                <a asp-page="/Series/Index" class="btn btn-outline-secondary">Cancelar</a>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
