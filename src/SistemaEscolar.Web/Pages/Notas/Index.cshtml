@page
@model SistemaEscolar.Web.Pages.Notas.IndexModel
@{
    ViewData["Title"] = "Notas";
    ViewData["Breadcrumb"] = new[] { "Acadêmico", "Notas" };
    var podeGerenciar = User.IsInRole("Diretor") || User.IsInRole("Coordenador") || User.IsInRole("Cordenador") || User.IsInRole("Secretaria") || User.IsInRole("Professor");
}

<section class="panel">
    <div class="panel-header d-flex justify-content-between align-items-center">
        <div>
            <h1 class="h5 mb-1">Lançamento de Notas</h1>
            <p class="text-muted mb-0">Clique em um lançamento para abrir o boletim completo do aluno.</p>
        </div>
        @if (podeGerenciar)
        {
            <div class="d-flex gap-2">
                <button type="button" class="btn btn-outline-primary btn-sm" data-bs-toggle="modal" data-bs-target="#abrirBoletimModal">
                    Abrir Boletim de um Aluno
                </button>
                <button type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-2" data-bs-toggle="modal" data-bs-target="#lancamentoMassaModal">
                    <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M0 2a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm15 2h-4v3h4zm0 4h-4v3h4zm0 4h-4v3h3a1 1 0 0 0 1-1zm-5 3v-3H6v3zm-5 0v-3H1v2a1 1 0 0 0 1 1zm-4-4h4V8H1zm0-4h4V4H1zm5-3v3h4V4zm4 4H6v3h4z" /></svg>
                    Lançamento em Massa
                </button>
            </div>
        }
    </div>
    <div class="panel-body">
        <form method="get" class="row g-2 mb-3">
            <input type="hidden" name="PageNumber" value="1" />
            <div class="col-12 col-md-4">
                <input asp-for="Busca" class="form-control" placeholder="Buscar por aluno, disciplina ou professor" />
            </div>
            <div class="col-12 col-md-2">
                <select asp-for="AnoLetivo" class="form-select">
                    <option value="">Todos os anos</option>
                    @foreach (var ano in Model.AnosDisponiveis)
                    {
                        <option value="@ano">@ano</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-2">
                <select asp-for="Trimestre" class="form-select">
                    <option value="">Todos trimestres</option>
                    <option value="1">1° Trimestre</option>
                    <option value="2">2° Trimestre</option>
                    <option value="3">3° Trimestre</option>
                </select>
            </div>
            <div class="col-12 col-md-2">
                <select asp-for="Status" class="form-select">
                    <option value="todos">Todos</option>
                    <option value="finalizadas">Finalizadas</option>
                    <option value="pendentes">Pendentes</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-page="/Notas/Index" class="btn btn-outline-secondary">Limpar</a>
            </div>
        </form>

        <div class="panel-table-wrap">
            <table class="table-sneat">
                <thead>
                    <tr>
                        <th>Aluno</th>
                        <th>Disciplina</th>
                        <th>Professor</th>
                        <th>Período</th>
                        <th>1a Aval.</th>
                        <th>2a Aval.</th>
                        <th>3a Aval.</th>
                        <th>Res. Unidade</th>
                        <th>Rec. Paralela</th>
                        <th>Res. Final Unidade</th>
                        <th>Status</th>
                        <th style="width:110px">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Notas.Count == 0)
                    {
                        <tr>
                            <td colspan="12" class="text-center text-muted">Nenhum lançamento encontrado.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var nota in Model.Notas)
                        {
                            <tr class="@(podeGerenciar ? "row-clicavel" : null)"
                                data-href="/Notas/Boletim?alunoId=@nota.AlunoId&periodoId=@nota.PeriodoLancamentoId">
                                <td>@nota.AlunoNome</td>
                                <td>@nota.DisciplinaNome</td>
                                <td>@nota.ProfessorNome</td>
                                <td>@nota.PeriodoDescricao</td>
                                <td>@(nota.Avaliacao1?.ToString("0.00") ?? "-")</td>
                                <td>@(nota.Avaliacao2?.ToString("0.00") ?? "-")</td>
                                <td>@(nota.Avaliacao3?.ToString("0.00") ?? "-")</td>
                                <td>@nota.ResultadoUnidade.ToString("0.00")</td>
                                <td>@(nota.RecuperacaoParalela?.ToString("0.00") ?? "-")</td>
                                <td>@nota.ResultadoFinalUnidade.ToString("0.00")</td>
                                <td>
                                    <span class="status-pill @(nota.IsFinalizada ? "status-open" : "status-warn")">
                                        @(nota.IsFinalizada ? "Finalizada" : "Pendente")
                                    </span>
                                </td>
                                <td>
                                    @if (podeGerenciar)
                                    {
                                        <div class="actions-cell">
                                            <form method="post" asp-page-handler="ToggleStatus" asp-route-id="@nota.Id" class="m-0">
                                                <input type="hidden" name="busca" value="@Model.Busca" />
                                                <input type="hidden" name="status" value="@Model.Status" />
                                                <input type="hidden" name="anoLetivo" value="@Model.AnoLetivo" />
                                                <input type="hidden" name="trimestre" value="@Model.Trimestre" />
                                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                <button type="submit" class="icon-btn toggle" title="@(nota.IsFinalizada ? "Reabrir" : "Finalizar")"
                                                        onclick="return confirm('Tem certeza que deseja @(nota.IsFinalizada ? "reabrir" : "finalizar") este lançamento?');">
                                                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M2.5 8a5.5 5.5 0 0 1 8.25-4.764.5.5 0 0 0 .5-.866A6.5 6.5 0 1 0 14.5 8a.5.5 0 0 0-1 0 5.5 5.5 0 1 1-11 0z" /><path d="M15.354 3.354a.5.5 0 0 0-.708-.708L8 9.293 5.854 7.146a.5.5 0 1 0-.708.708l2.5 2.5a.5.5 0 0 0 .708 0z" /></svg>
                                                </button>
                                            </form>
                                            <form method="post" asp-page-handler="Delete" asp-route-id="@nota.Id" class="m-0">
                                                <input type="hidden" name="busca" value="@Model.Busca" />
                                                <input type="hidden" name="status" value="@Model.Status" />
                                                <input type="hidden" name="anoLetivo" value="@Model.AnoLetivo" />
                                                <input type="hidden" name="trimestre" value="@Model.Trimestre" />
                                                <input type="hidden" name="pageNumber" value="@Model.PageNumber" />
                                                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                                                <button type="submit" class="icon-btn delete" title="Excluir"
                                                        onclick="return confirm('Tem certeza que deseja excluir este lançamento?');">
                                                    <svg viewBox="0 0 16 16" fill="currentColor"><path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5Zm3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0V6Z" /><path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z" /></svg>
                                                </button>
                                            </form>
                                            <span class="row-chevron">
                                                <svg viewBox="0 0 16 16" fill="currentColor"><path d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708" /></svg>
                                            </span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Somente consulta</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-3">
            <small class="text-muted">
                Exibindo @Model.Notas.Count de @Model.TotalCount lançamento(s) na página @Model.PageNumber de
                @Model.TotalPages.
            </small>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Paginação de notas">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : string.Empty)">
                            <a class="page-link" asp-page="/Notas/Index" asp-route-Busca="@Model.Busca"
                               asp-route-Status="@Model.Status" asp-route-AnoLetivo="@Model.AnoLetivo"
                               asp-route-Trimestre="@Model.Trimestre" asp-route-PageSize="@Model.PageSize"
                               asp-route-PageNumber="@(Model.PageNumber - 1)">Anterior</a>
                        </li>

                        @for (var i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : string.Empty)">
                                <a class="page-link" asp-page="/Notas/Index" asp-route-Busca="@Model.Busca"
                                   asp-route-Status="@Model.Status" asp-route-AnoLetivo="@Model.AnoLetivo"
                                   asp-route-Trimestre="@Model.Trimestre" asp-route-PageSize="@Model.PageSize"
                                   asp-route-PageNumber="@i">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : string.Empty)">
                            <a class="page-link" asp-page="/Notas/Index" asp-route-Busca="@Model.Busca"
                               asp-route-Status="@Model.Status" asp-route-AnoLetivo="@Model.AnoLetivo"
                               asp-route-Trimestre="@Model.Trimestre" asp-route-PageSize="@Model.PageSize"
                               asp-route-PageNumber="@(Model.PageNumber + 1)">Próxima</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</section>

@if (podeGerenciar)
{
    <div class="modal fade" id="abrirBoletimModal" tabindex="-1" aria-labelledby="abrirBoletimModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-2">
                        <span class="modal-header-icon" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10Z" />
                            </svg>
                        </span>
                        <h5 class="modal-title" id="abrirBoletimModalLabel">Abrir Boletim de um Aluno</h5>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button>
                </div>
                <form method="get" asp-page="/Notas/Boletim">
                    <div class="modal-body">
                        <p class="small text-muted">Escolha o aluno para lançar ou revisar as notas de todas as disciplinas dele em um só lugar.</p>
                        <div class="mb-3">
                            <label for="abrir-boletim-aluno-id" class="form-label">Aluno</label>
                            <select id="abrir-boletim-aluno-id" name="AlunoId" class="form-select" required>
                                <option value="">Selecione...</option>
                                @foreach (var aluno in Model.Alunos)
                                {
                                    <option value="@aluno.Value">@aluno.Text</option>
                                }
                            </select>
                        </div>
                        <div class="mb-1">
                            <label for="abrir-boletim-periodo-id" class="form-label">Período (opcional)</label>
                            <select id="abrir-boletim-periodo-id" name="PeriodoId" class="form-select">
                                <option value="">Período aberto mais recente</option>
                                @foreach (var periodo in Model.Periodos)
                                {
                                    <option value="@periodo.Value">@periodo.Text</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Abrir Boletim</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <partial name="_LancamentoMassaModal" model="Model.LancamentoMassaModal" />
}
