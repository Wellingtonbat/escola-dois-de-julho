@page
@model SistemaEscolar.Web.Pages.LoginModel
@{
    Layout = "/Pages/Shared/_AuthLayout.cshtml";
    ViewData["Title"] = "Entrar";
}

<div class="login-split">
    <section class="login-hero">
        <div class="login-hero-ring login-hero-ring-outer" aria-hidden="true"></div>
        <div class="login-hero-ring login-hero-ring-inner" aria-hidden="true"></div>
        <div class="login-hero-dot" aria-hidden="true"></div>

        <div class="login-hero-brand">
            <span class="login-hero-logo" aria-hidden="true">
                <svg viewBox="0 0 40 40" fill="none"><rect width="40" height="40" rx="12" fill="#F2B233"></rect><path d="M9 27V14c3.5-1.7 7-1.5 11 1.2 4-2.7 7.5-2.9 11-1.2v13c-3.5-1.7-7-1.5-11 1.2-4-2.7-7.5-2.9-11-1.2z" stroke="#0F1D40" stroke-width="2.2" stroke-linejoin="round"></path><path d="M20 15.2v13" stroke="#0F1D40" stroke-width="2.2"></path></svg>
            </span>
            <div>
                <span class="login-hero-brand-name">Sistema Escolar</span>
                <span class="login-hero-brand-school">Escola Dois de Julho</span>
            </div>
        </div>

        <div class="login-hero-pitch">
            <h1>Notas, turmas e boletins em um só lugar.</h1>
            <ul class="login-hero-benefits">
                <li>
                    <span class="login-hero-benefit-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" /></svg>
                    </span>
                    Lançamento de notas em massa, com salvamento automático
                </li>
                <li>
                    <span class="login-hero-benefit-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16h16V8z" /><path d="M14 2v6h6" /></svg>
                    </span>
                    Boletins em PDF no modelo da escola
                </li>
                <li>
                    <span class="login-hero-benefit-icon" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18M7 15l4-4 3 3 5-6" /></svg>
                    </span>
                    Painel com aprovação e pendências de cada turma
                </li>
            </ul>
        </div>

        <div class="login-hero-footer">Desenvolvido por Well Tech</div>
    </section>

    <section class="login-form-side">
        <div class="login-form-card">
            <div>
                <h2 class="login-form-title">Bem-vindo de volta</h2>
                <p class="login-form-subtitle">Entre com seu CPF e sua senha para acessar o painel.</p>
            </div>

            <form method="post" class="login-form">
                <div asp-validation-summary="ModelOnly" class="login-form-error"></div>

                <div class="login-field">
                    <label asp-for="Input.Cpf" class="login-label"></label>
                    <input asp-for="Input.Cpf" class="login-input" placeholder="Somente os 11 números do CPF" inputmode="numeric" autocomplete="username" autofocus data-cpf-somente-numeros />
                    <span asp-validation-for="Input.Cpf" class="login-field-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Input.Password" class="login-label"></label>
                    <input asp-for="Input.Password" class="login-input" autocomplete="current-password" />
                    <span asp-validation-for="Input.Password" class="login-field-error"></span>
                </div>

                <div class="login-remember">
                    <input asp-for="Input.RememberMe" class="login-checkbox" />
                    <label asp-for="Input.RememberMe"></label>
                </div>

                <button type="submit" class="btn btn-primary login-submit">Entrar</button>

                <p class="login-help">Esqueceu a senha? Peça à direção ou à coordenação para redefinir.</p>
            </form>
        </div>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // CPF: aceita colar "025.452.775-25" (ou qualquer texto) e mantém só os 11 números.
        // Não usamos maxlength de propósito: ele cortaria o texto colado antes de tirarmos a pontuação.
        document.querySelectorAll("[data-cpf-somente-numeros]").forEach((input) => {
            const limpar = () => {
                const numeros = input.value.replace(/\D/g, "").slice(0, 11);
                if (input.value !== numeros) {
                    input.value = numeros;
                }
            };
            input.addEventListener("input", limpar);
            input.addEventListener("change", limpar);
            limpar();
        });
    </script>
}
