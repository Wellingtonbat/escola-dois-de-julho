@page
@model SistemaEscolar.Web.Pages.Auditoria.IndexModel
@{
    ViewData["Title"] = "Auditoria";
    ViewData["Breadcrumb"] = new[] { "Administração", "Auditoria" };
}

<section class="panel">
    <div class="panel-header">
        <div>
            <h1 class="h5 mb-1">Auditoria</h1>
            <p class="text-muted mb-0">Quem cadastrou, alterou ou excluiu informações no sistema, e quando. Acesso restrito a Diretor e Vice-Diretor. Horários de Brasília.</p>
        </div>
    </div>
    <div class="panel-body">
        <form method="get" class="row g-2 mb-3">
            <input type="hidden" name="PageNumber" value="1" />
            <div class="col-12 col-md-2">
                <label for="audit-de" class="form-label small text-muted mb-1">De</label>
                <input id="audit-de" type="date" name="De" class="form-control" value="@Model.De?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-2">
                <label for="audit-ate" class="form-label small text-muted mb-1">Até</label>
                <input id="audit-ate" type="date" name="Ate" class="form-control" value="@Model.Ate?.ToString("yyyy-MM-dd")" />
            </div>
            <div class="col-12 col-md-3">
                <label for="audit-usuario" class="form-label small text-muted mb-1">Usuário (nome ou CPF)</label>
                <input id="audit-usuario" asp-for="Usuario" class="form-control" placeholder="Quem fez a alteração" />
            </div>
            <div class="col-12 col-md-2">
                <label for="audit-entidade" class="form-label small text-muted mb-1">O que foi alterado</label>
                <select id="audit-entidade" asp-for="Entidade" asp-items="Model.Entidades" class="form-select">
                    <option value="">Tudo</option>
                </select>
            </div>
            <div class="col-12 col-md-1">
                <label for="audit-acao" class="form-label small text-muted mb-1">Ação</label>
                <select id="audit-acao" asp-for="Acao" class="form-select">
                    <option value="">Todas</option>
                    <option value="criado">Criado</option>
                    <option value="alterado">Alterado</option>
                    <option value="excluido">Excluído</option>
                </select>
            </div>
            <div class="col-12 col-md-2 d-flex gap-2 align-items-end">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-page="/Auditoria/Index" class="btn btn-outline-secondary">Limpar</a>
            </div>
        </form>

        <div class="panel-table-wrap">
            <table class="table-sneat">
                <thead>
                    <tr>
                        <th>Data e hora</th>
                        <th>Usuário</th>
                        <th>Ação</th>
                        <th>O que</th>
                        <th>Registro</th>
                        <th>Detalhes</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Registros.Count == 0)
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">Nenhum registro encontrado para os filtros informados.</td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Registros)
                        {
                            <tr>
                                <td class="text-nowrap">@item.DataHoraLocal.ToString("dd/MM/yyyy HH:mm:ss")</td>
                                <td>
                                    @item.Usuario
                                    @if (!string.IsNullOrWhiteSpace(item.UsuarioLogin) && !item.Usuario.StartsWith("CPF "))
                                    {
                                        <br /><small class="text-muted">CPF @item.UsuarioLogin</small>
                                    }
                                </td>
                                <td><span class="status-pill @item.ClasseAcao">@item.Acao</span></td>
                                <td>@item.Entidade</td>
                                <td>@item.Registro</td>
                                <td>
                                    @if (item.Alteracoes.Count == 0)
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else
                                    {
                                        <details>
                                            <summary class="small">@item.Alteracoes.Count campo(s)</summary>
                                            <ul class="list-unstyled small mb-0 mt-1">
                                                @foreach (var alteracao in item.Alteracoes)
                                                {
                                                    <li>
                                                        <strong>@alteracao.Campo:</strong>
                                                        @if (alteracao.ValorAnterior is not null && alteracao.ValorNovo is not null)
                                                        {
                                                            <span class="text-muted">@alteracao.ValorAnterior</span>
                                                            <span aria-hidden="true">→</span>
                                                            <span>@alteracao.ValorNovo</span>
                                                        }
                                                        else
                                                        {
                                                            <span>@(alteracao.ValorNovo ?? alteracao.ValorAnterior)</span>
                                                        }
                                                    </li>
                                                }
                                            </ul>
                                        </details>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-2 mt-3">
            <small class="text-muted">
                Exibindo @Model.Registros.Count de @Model.TotalCount registro(s) na página @Model.PageNumber de
                @Model.TotalPages.
            </small>

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="Paginação da auditoria">
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : string.Empty)">
                            <a class="page-link" asp-page="/Auditoria/Index" asp-route-De="@Model.De?.ToString("yyyy-MM-dd")"
                               asp-route-Ate="@Model.Ate?.ToString("yyyy-MM-dd")" asp-route-Usuario="@Model.Usuario"
                               asp-route-Entidade="@Model.Entidade" asp-route-Acao="@Model.Acao"
                               asp-route-PageNumber="@(Model.PageNumber - 1)">Anterior</a>
                        </li>
                        <li class="page-item disabled"><span class="page-link">@Model.PageNumber / @Model.TotalPages</span></li>
                        <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : string.Empty)">
                            <a class="page-link" asp-page="/Auditoria/Index" asp-route-De="@Model.De?.ToString("yyyy-MM-dd")"
                               asp-route-Ate="@Model.Ate?.ToString("yyyy-MM-dd")" asp-route-Usuario="@Model.Usuario"
                               asp-route-Entidade="@Model.Entidade" asp-route-Acao="@Model.Acao"
                               asp-route-PageNumber="@(Model.PageNumber + 1)">Próxima</a>
                        </li>
                    </ul>
                </nav>
            }
        </div>
    </div>
</section>
